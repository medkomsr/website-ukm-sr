# Public identifiers: obtain from the project's Sanity administrator.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Local development uses the isolated test dataset. Vercel Production uses production.
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: direct email delivery after campus IT authorization.
# Never prefix these secrets with NEXT_PUBLIC_.
CONTACT_ENABLED=false
CONTACT_REDIS_REST_URL=
CONTACT_REDIS_REST_TOKEN=
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM=

# Shared only between the Sanity webhook and the server (random 32+ characters).
SANITY_REVALIDATE_SECRET=
