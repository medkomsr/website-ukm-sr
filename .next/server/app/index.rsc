13:["$","$L28",null,{"state":{"mutations":[],"queries":[{"dehydratedAt":1795628200116,"state":{"data":{"companyVideoPosterUrl":null,"companyVideoUrl":"https://cdn.sanity.io/files/yzaa35ug/production/8e9979108aa8ad12f034c4c5c0824f5602132663.webm"},"dataUpdateCount":1,"dataUpdatedAt":1795628199892,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchFailureReason":null,"fetchMeta":null,"isInvalidated":false,"status":"success","fetchStatus":"idle"},"queryKey":["homePage"],"queryHash":"[\"homePage\"]"},{"dehydratedAt":1795628200116,"state":{"data":[{"_id":"berita-gbqn-xi-2026","slug":"gbqn-xi-2026-tilawah-karya-ilmiah-1269-peserta-di-malang","type":"article","title":"Dari Tilawah hingga Karya Ilmiah, GBQN XI Pertemukan 1.269 Peserta di Malang","description":"Malang, sebanyak 1.269 peserta dari 12 provinsi mengikuti Gebyar Brawijaya Qur’ani Nasional (GBQN) XI di Universitas Brawijaya (UB) pada 24–27 September 2026. Ajang dua tahunan Unit Kegiatan Mahasiswa Seni Religi UB ini mempertemukan pelajar dan mahasiswa dalam sepuluh cabang, dari tilawah dan hafalan hingga debat, kaligrafi, dan karya ilmiah.","imageUrl":"https://cdn.sanity.io/images/yzaa35ug/production/3016f3149f216c400c943ca778e321e9b238c398-1920x1282.png","category":"Liputan","date":"24 November 2026","time":"","location":"","tags":[],"body":[],"agenda":[],"gallery":[]},{"_id":"berita-diklat-anggota-ukm-seni-religi-2026","slug":"diklat-anggota-ukm-seni-religi-2026-jadi-langkah-awal-membangun-generasi-berjiwa-qurani","type":"article","title":"Diklat Anggota UKM Seni Religi 2026 Jadi Langkah Awal Membangun Generasi Berjiwa Qur'ani","description":"Sebanyak 68 peserta mengikuti Diklat Anggota UKM Seni Religi UB di Malang dan Kota Batu. Mereka mengenal delapan bidang melalui Muhadhoroh dan berdiskusi langsung dengan pengurus sebelum pengukuhan anggota.","imageUrl":"https://cdn.sanity.io/images/yzaa35ug/production/820b3f6ed2dafaf564415355036280d140a4f502-4032x3024.jpg","category":"Liputan","date":"24 November 2026","time":"","location":"","tags":[],"body":[],"agenda":[],"gallery":[]},{"_id":"berita-mtq-ub-xix-2026","slug":"mtq-ub-xix-2026-403-peserta-fakultas-teknik-juara-umum","type":"article","title":"MTQ UB XIX 2026 Diikuti 403 Peserta, Fakultas Teknik Raih Juara Umum","description":"Musabaqah Tilawatil Qur’an Universitas Brawijaya XIX berlangsung pada 4–7 Mei 2026 dengan 403 peserta dari berbagai fakultas. Fakultas Teknik kembali meraih gelar juara umum.","imageUrl":"https://cdn.sanity.io/images/yzaa35ug/production/d57b910df52d7304093e300f70d3862cd32f2dbc-3008x1688.jpg","category":"Liputan","date":"16 November 2026","time":"","location":"","tags":[],"body":[],"agenda":[],"gallery":[]}],"dataUpdateCount":1,"dataUpdatedAt":1795628200116,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchFailureReason":null,"fetchMeta":null,"isInvalidated":false,"status":"success","fetchStatus":"idle"},"queryKey":["aktivitas","home"],"queryHash":"[\"aktivitas\",\"home\"]"},{"dehydratedAt":1795628200116,"state":{"data":[{"_id":"prestasi-2026-gbqn-ub-msq","title":"GBQN UB – MSQ","year":2026,"category":"Kompetisi","level":"Nasional","description":"Fikri Fadhillah, Masrukin Kafanur 'Abidin, dan Fahry Noer Muhammad meraih juara 2 cabang MSQ pada GBQN UB tahun 2026.","position":"Juara 2","field":"Syarhil","organizer":"","location":"","imageUrl":"","imageAlt":"","participants":[{"_key":"954b31df4a9ab530","name":"Fikri Fadhillah","faculty":"FISIP / Ilmu Pemerintahan","imageUrl":""},{"_key":"3af830c7ae0fb390","name":"Masrukin Kafanur 'Abidin","faculty":"FPIK / S1 Budidaya Perairan","imageUrl":""},{"_key":"a2e500520acbad21","name":"Fahry Noer Muhammad","faculty":"FIA / Administrasi Publik","imageUrl":""}]},{"_id":"prestasi-2026-gebyar-tafsir-isqi-msq","title":"Gebyar Tafsir ISQI – MSQ","year":2026,"category":"Kompetisi","level":"Nasional","description":"Masrukin Kafanur 'Abidin meraih juara 1 cabang MSQ pada Gebyar Tafsir ISQI tahun 2026.","positi