e:[["children",{"s":"__PAGE__","h":49312,"d":{"r":["$","$1","c",{"children":[["$","div",null,{"className":"sr-public min-h-screen flex flex-col font-sans","children":[[["$","a",null,{"className":"TxUrna_skip","href":"#main-content","children":"Lewati ke konten"}],["$","$L13",null,{}]],["$","div",null,{"children":["$","div",null,{"className":"pt-[88px] max-[900px]:pt-[76px]","children":[["$","main",null,{"id":"main-content","tabIndex":-1,"className":"flex-1 scroll-mt-24","children":["$","div",null,{"children":[["$","$L14",null,{}],["$","$2",null,{"fallback":["$","div",null,{"data-tone":"cream","className":"_99NsXq_root _99NsXq_compact","role":"status","aria-label":"Memuat konten","aria-busy":"true","children":["$","div",null,{"className":"_99NsXq_copy","aria-hidden":"true","children":[["$","span",null,{"className":"_99NsXq_eyebrow"}],["$","span",null,{"className":"_99NsXq_title"}],["$","span",null,{"className":"_99NsXq_line"}],["$","span",null,{"className":"_99NsXq_line"}]]}]}],"children":["$","$L16",null,{"state":{"mutations":[],"queries":[{"dehydratedAt":1795667155102,"state":{"data":[{"_id":"tentang-seni-religi","pertanyaan":"Apa sih UKM Seni Religi itu?","jawaban":"Seni Religi merupakan salah satu Unit Kegiatan Mahasiswa (UKM) di Universitas Brawijaya yang menjadi wadah bagi mahasiswa untuk mengembangkan minat dan bakat di bidang seni Islami dan Qur’ani. UKM ini didirikan pada 10 Muharram 1433 H, bertepatan dengan tahun 2012, sebagai bentuk komitmen dalam mewadahi kreativitas mahasiswa yang bernilai religius di lingkungan Universitas Brawijaya."},{"_id":"program-prioritas","pertanyaan":"Apa Program Prioritas UKM Seni Religi?","jawaban":"Pertama, Musabaqah Tilawatil Qur’an Mahasiswa Nasional (MTQMN) merupakan ajang kompetisi tingkat nasional yang diselenggarakan oleh Kementerian Pendidikan Tinggi dengan siklus penyelenggaraan dua tahun sekali.\n\nKedua, Gebyar Brawijaya Qur’ani Nasional (GBQN) diselenggarakan pada tahun ketika MTQMN tidak berlangsung. GBQN merupakan kompetisi Al-Qur’an tingkat nasional yang juga menjadi sarana pengenalan Universitas Brawijaya kepada siswa SMA/sederajat sekaligus menjaring calon mahasiswa berprestasi di bidang Al-Qur’an.\n\nKetiga, MTQ Universitas Brawijaya (MTQ UB) merupakan kompetisi internal tingkat Universitas yang diselenggarakan setiap tahun. Kegiatan ini berfungsi sebagai wadah penjaringan dan pembinaan mahasiswa berprestasi untuk mempersiapkan kafilah Universitas Brawijaya yang akan berlaga di MTQMN."},{"_id":"kegiatan-lain","pertanyaan":"Apakah UKM Seni Religi hanya berfokus pada pembinaan prestasi, atau juga memiliki kegiatan lainnya?","jawaban":"Tentu tidak. UKM Seni Religi tidak hanya berfokus pada pembinaan prestasi dan kompetisi Al-Qur’an, tetapi juga memiliki banyak kegiatan keagamaan, kebersamaan, dan pengembangan organisasi.\n\nBeberapa di antaranya adalah YKS (Yuk Kita Sholawatan) yang dilaksanakan setiap malam Jumat secara bergiliran di masjid-masjid fakultas, 3N (Ngaji, Ngopi, Njagong) berupa kegiatan khotmil Qur’an di masjid fakultas, Safari Khotmil, Wisata Religi, Muktamar, Harlah, serta kegiatan sowan kepada pembina."}],"dataUpdateCount":1,"dataUpdatedAt":1795667155102,"error":null,"errorUpdateCount":0,"errorUpdatedAt":0,"fetchFailureCount":0,"fetchFailureReason":null,"fetchMeta":null,"isInvalidated":false,"status":"success","fetchStatus":"idle"},"queryKey":["faq"],"queryHash":"[\"faq\"]"}]},"children":"$L17"}]}]]}]}],"$L18"]}]}]]}],["$L19","$L1a","$L1b","$L1c","$L1d","$L1e"],"$L1f"]}],"p":"$@20","v":"$21","s":"$a"}}]]
