{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.sanity.io https://images.unsplash.com https://i.ytimg.com; font-src 'self' data:; media-src 'self' blob: https://cdn.sanity.io; connect-src 'self' https://*.sanity.io wss://*.sanity.io https://www.youtube.com https://www.youtube-nocookie.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://*.sanity.io; worker-src 'self' blob:; form-action 'self'"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/aktivitas/[id]",
      "regex": "^/aktivitas/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/aktivitas/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/aktivitas/[id].segments/aktivitas/$d$id$segment",
          "source": "^/aktivitas/(?<nxtPid>[^/]+?)\\.segments/aktivitas/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    },
    {
      "page": "/api/arsip/[resource]",
      "regex": "^/api/arsip/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPresource": "nxtPresource"
      },
      "namedRegex": "^/api/arsip/(?<nxtPresource>[^/]+?)(?:/)?$"
    },
    {
      "page": "/studio/[[...tool]]",
      "regex": "^/studio(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPtool": "nxtPtool"
      },
      "namedRegex": "^/studio(?:/(?<nxtPtool>.+?))?(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/studio/[[...tool]].segments/studio/$oc$tool$segment",
          "source": "^/studio(?:/(?<nxtPtool>.+?))?\\.segments/studio/\\$oc\\$tool(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPtool": "nxtPtool"
          }
        }
      ]
    },
    {
      "page": "/tentang/bidang/[bidang]",
      "regex": "^/tentang/bidang/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbidang": "nxtPbidang"
      },
      "namedRegex": "^/tentang/bidang/(?<nxtPbidang>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/tentang/bidang/[bidang].segments/tentang/bidang/$d$bidang$segment",
          "source": "^/tentang/bidang/(?<nxtPbidang>[^/]+?)\\.segments/tentang/bidang/\\$d\\$bidang(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPbidang": "nxtPbidang"
          }
        }
      ]
    },
    {
      "page": "/tentang/[dept]",
      "regex": "^/tentang/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPdept": "nxtPdept"
      },
      "namedRegex": "^/tentang/(?<nxtPdept>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/tentang/[dept].segments/tentang/$d$dept$segment",
          "source": "^/tentang/(?<nxtPdept>[^/]+?)\\.segments/tentang/\\$d\\$dept(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPdept": "nxtPdept"
          }
        }
      ]
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/aktivitas",
      "regex": "^/aktivitas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/aktivitas(?:/)?$"
    },
    {
      "page": "/api/contact",
      "regex": "^/api/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/contact(?:/)?$"
    },
    {
      "page": "/api/sanity/revalidate",
      "regex": "^/api/sanity/revalidate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/sanity/revalidate(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/kontak",
      "regex": "^/kontak(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kontak(?:/)?$"
    },
    {
      "page": "/prestasi",
      "regex": "^/prestasi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/prestasi(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/tentang",
      "regex": "^/tentang(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tentang(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": true,
    "dynamicRSCPrerender": true
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "ppr": {
    "chain": {
      "headers": {
        "next-resume": "1"
      }
    }
  }
}